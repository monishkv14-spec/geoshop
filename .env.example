# GeoShop Global Application Environment Configuration

# --- BACKEND (Railway) ---
PORT=5000
NODE_ENV=production
# In Railway: PostgreSQL connection string from the PostgreSQL plugin
DATABASE_URL="postgresql://postgres:password@host:5432/railway"
# Permitted CORS origins (e.g. your Vercel deployment URL)
CORS_ORIGIN="*"
JWT_SECRET="geoshop_super_secret_jwt_key_2026_production_ready"

# --- FRONTEND (Vercel) ---
# Point to your Railway backend URL (ensure it includes the /api suffix)
VITE_API_BASE_URL="https://your-backend-service.up.railway.app/api"
