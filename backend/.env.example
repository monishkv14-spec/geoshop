# GeoShop Backend Environment Variables
# Port is automatically supplied by Railway, but defaults to 5000 locally
PORT=5000

# Set to "production" in Railway
NODE_ENV=production

# Railway PostgreSQL connection string (Automatically injected if you add a Postgres database plugin in Railway)
DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# Frontend Vercel URL(s) allowed for CORS requests (comma-separated or * for public access)
# Example: https://geoshop.vercel.app,http://localhost:5173
CORS_ORIGIN="*"

# Secret key for JWT sessions (any secure 32+ character random string)
JWT_SECRET="geoshop_super_secret_jwt_key_2026_production_ready"
